# --- Data (regenerable / too large for git) ---
# Raw DE-SynPUF CSVs — download from CMS instead of committing (~2 GB)
*.csv
# ...except the answer-key CSVs the Evaluation tab needs
!answer_keys/**/*.csv
# Clean parquet tables — regenerable via load_desynpuf.py, except the demo
# subsets committed so clones/deployments have the three demo datasets (~250 MB)
clean/*
!clean/sample1_dev_seeded/
!clean/sample2_dev_seeded/
!clean/sample2_seeded/
!clean/sample2_hard/
# Precomputed engine results — regenerable via precompute.py
results/*
!results/sample1_dev_seeded/
!results/sample2_dev_seeded/
!results/sample2_seeded/
!results/sample2_hard/

# --- Vercel build artifact (created by vercel.json buildCommand) ---
api/_bundle/

# --- Node / frontend ---
node_modules/
web/dist/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Logs, caches, scratch ---
*.log
.ai_cache/
Untitled*.ipynb
.ipynb_checkpoints/

# --- Old copies kept locally ---
rd_engine_old/
rd_engine_o1/

.vercel
.env*
