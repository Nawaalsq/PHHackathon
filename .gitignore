# --- Data (regenerable / too large for git) ---
# Raw DE-SynPUF CSVs — download from CMS instead of committing (~2 GB)
*.csv
# Clean parquet tables — regenerable via load_desynpuf.py, except the small
# dev subset committed so the deployed backend has demo data (~16 MB)
clean/*
!clean/sample1_dev_seeded/
# Precomputed engine results — regenerable via precompute.py
results/*
!results/sample1_dev_seeded/

# --- Node / frontend ---
node_modules/
web/dist/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Logs, caches, scratch ---
*.log
.ai_cache/
Untitled*.ipynb
.ipynb_checkpoints/

# --- Old copies kept locally ---
rd_engine_old/
rd_engine_o1/
